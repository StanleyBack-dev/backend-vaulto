{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "master": false
    }
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "src/assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
